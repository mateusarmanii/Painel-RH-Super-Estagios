generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Franquia {
  id         Int         @id @default(autoincrement())
  nome       String
  cidade     String
  login      String      @unique
  senha_hash String
  criado_em  DateTime    @default(now())
  empresas   Empresa[]
  candidatos Candidato[]

  @@map("franquias")
}

model Empresa {
  id          Int       @id @default(autoincrement())
  franquia_id Int
  nome        String
  contato     String
  email       String?
  franquia    Franquia  @relation(fields: [franquia_id], references: [id])
  vagas       Vaga[]

  @@map("empresas")
}

model Vaga {
  id          Int         @id @default(autoincrement())
  empresa_id  Int
  codigo      String      @unique @db.VarChar(6)
  link        String
  nome        String
  aberta      Boolean     @default(true)
  criado_em   DateTime    @default(now())
  empresa     Empresa     @relation(fields: [empresa_id], references: [id])
  aplicacoes  Aplicacao[]

  @@map("vagas")
}

model Candidato {
  id             String      @id @default(uuid()) @db.Uuid
  franquia_id    Int
  nome           String
  telefone       String
  curso          String
  instituicao    String
  cep            String
  endereco       String
  curriculo_path String
  status_banco   String?
  criado_em      DateTime    @default(now())
  franquia       Franquia    @relation(fields: [franquia_id], references: [id])
  aplicacoes     Aplicacao[]

  @@index([franquia_id])

  @@map("candidatos")
}

model Aplicacao {
  id             String       @id @default(uuid()) @db.Uuid
  vaga_id        Int
  candidato_id   String       @db.Uuid
  status_funil   String       @default("Enviado para a Empresa")
  data_aplicacao DateTime     @default(now())
  contratada_em  DateTime?
  removida_em    DateTime?
  vaga           Vaga         @relation(fields: [vaga_id], references: [id])
  candidato      Candidato    @relation(fields: [candidato_id], references: [id])
  entrevistas    Entrevista[]

  @@index([candidato_id])
  @@index([vaga_id, removida_em])

  @@map("aplicacoes")
}

model Entrevista {
  id               String    @id @default(uuid()) @db.Uuid
  aplicacao_id     String    @db.Uuid
  data_hora_inicio DateTime
  data_hora_fim    DateTime
  link_reuniao     String?
  status           String    @default("Agendada")
  relatorio_path   String?
  aplicacao        Aplicacao @relation(fields: [aplicacao_id], references: [id])

  @@map("entrevistas")
}