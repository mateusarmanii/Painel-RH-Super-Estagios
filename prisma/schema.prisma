generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Franquia {
  id        Int       @id @default(autoincrement())
  nome      String
  cidade    String
  criado_em DateTime  @default(now())
  empresas  Empresa[]

  @@map("franquias")
}

model Empresa {
  id          Int       @id @default(autoincrement())
  franquia_id Int
  nome        String
  cnpj        String
  contato     String
  email       String
  franquia    Franquia  @relation(fields: [franquia_id], references: [id])
  vagas       Vaga[]

  @@map("empresas")
}

model Vaga {
  id        Int      @id @default(autoincrement())
  empresa_id Int
  titulo    String
  status    String
  criado_em DateTime @default(now())
  empresa   Empresa  @relation(fields: [empresa_id], references: [id])

  @@map("vagas")
}