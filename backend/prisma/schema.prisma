generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HorarioEstudo {
  MANHA
  TARDE
  NOITE
}

enum StatusVaga {
  ABERTA
  FECHADA
  SUSPENSA
}

enum TurnoEstudo {
  MANHA
  TARDE
  NOITE
  INTEGRAL
  EAD
}

enum Periodo {
  MANHA
  TARDE
  NOITE
}

enum TurnoVaga {
  MANHA
  TARDE
  INTEGRAL
}

enum ModalidadeVaga {
  PRESENCIAL
  HIBRIDA
  HOME_OFFICE
}

// Preferência de sexo informada pela empresa. Campo INTERNO: nunca vai em textos enviados a candidatos.
enum SexoPreferencia {
  FEMININO
  MASCULINO
}

enum EntrevistaStatus {
  AGUARDANDO
  CONFIRMADA
  REALIZADA
  NAO_COMPARECEU
  CANCELADA
}

enum EntrevistaFormato {
  PRESENCIAL
  ONLINE
}

// Etapas da candidatura, na ordem do Kanban. AGUARDANDO_RETORNO ("Em análise") não é mais usado: as candidaturas
// foram movidas para EM_TESTE e o valor fica só para não recriar o tipo (veja src/etapas.js).
enum StatusKanban {
  CANDIDATO_CONTATADO
  ENVIADO_EMPRESA
  ENTREVISTA_AGENDADA
  EM_TESTE
  AGUARDANDO_RETORNO
  APROVADO
  RECUSADO
}

enum PapelUsuario {
  ADMIN
  RECRUTADOR
}

// Quem entra no painel. Sem cadastro público: usuários são criados com "npm run usuario:criar".
// E-mail guardado sempre em minúsculas; a senha só como hash bcrypt.
model Usuario {
  id         String          @id @default(uuid()) @db.Uuid
  nome       String
  email      String          @unique
  senha_hash String
  papel      PapelUsuario    @default(RECRUTADOR)
  ativo      Boolean         @default(true)
  created_at DateTime        @default(now())
  updated_at DateTime        @default(now()) @updatedAt
  // Só do lado do Prisma (a chave estrangeira fica nas tabelas novas).
  eventos    Evento[]
  lembretes  LembreteEmail[]
}

// Compromisso do Calendário que não é entrevista (reunião, visita, prazo...).
// Dia inteiro: "inicio" guarda 00:00 de São Paulo daquele dia e a duração é 1440.
model Evento {
  id              String          @id @default(uuid()) @db.Uuid
  titulo          String          @db.VarChar(120)
  descricao       String?         @db.Text
  inicio          DateTime
  duracao_minutos Int             @default(60)
  dia_inteiro     Boolean         @default(false)
  criado_por_id   String?         @db.Uuid
  created_at      DateTime        @default(now())
  updated_at      DateTime        @default(now()) @updatedAt
  criado_por      Usuario?        @relation(fields: [criado_por_id], references: [id], onDelete: SetNull)
  lembretes       LembreteEmail[]

  @@index([inicio])
}

enum TipoLembrete {
  CONVITE
  CANCELAMENTO
}

// Registro de cada e-mail de lembrete (convite .ics) enviado, de um evento ou de uma entrevista (Aplicacao).
// Mesmo UID em todos os envios do mesmo compromisso; SEQUENCE cresce a cada envio, para o celular atualizar
// o compromisso em vez de duplicar. Fica guardado mesmo se o evento for excluído (o vínculo vira NULL).
model LembreteEmail {
  id              String       @id @default(uuid()) @db.Uuid
  evento_id       String?      @db.Uuid
  aplicacao_id    String?      @db.Uuid
  tipo            TipoLembrete @default(CONVITE)
  email_destino   String       @db.VarChar(254)
  enviado_em      DateTime     @default(now())
  enviado_por_id  String?      @db.Uuid
  uid             String       @db.VarChar(255)
  sequence        Int
  // Alarmes do convite, em minutos antes do início (reaproveitados ao reenviar).
  alarmes_minutos Int[]        @default([])
  // Horário que foi no convite: se o compromisso mudar, o painel oferece reenviar.
  inicio_convite  DateTime
  fim_convite     DateTime
  evento          Evento?      @relation(fields: [evento_id], references: [id], onDelete: SetNull)
  aplicacao       Aplicacao?   @relation(fields: [aplicacao_id], references: [id], onDelete: SetNull)
  enviado_por     Usuario?     @relation(fields: [enviado_por_id], references: [id], onDelete: SetNull)

  @@index([uid])
  @@index([enviado_por_id, enviado_em])
}

model Empresa {
  id               String  @id @default(uuid()) @db.Uuid
  nome             String
  setor            String? @default("Nao informado")
  nome_contato     String
  telefone_contato String
  email_contato    String?
  logo_url         String?
  vagas            Vaga[]
}

model Estudante {
  id                   String         @id @default(uuid()) @db.Uuid
  nome_completo        String
  telefone             String
  email                String?
  curso                String
  instituicao_ensino   String?
  link_curriculo       String?
  endereco             String?
  // CEP só com os 8 dígitos; cidade e bairro vêm do ViaCEP e podem ser editados.
  cep                  String?        @db.VarChar(8)
  cidade               String?
  bairro               String?
  // Campo antigo, mantido como histórico; as telas usam turno_estudo.
  horario_estudo       HorarioEstudo?
  anotacoes_recrutador String?        @db.Text
  turno_estudo         TurnoEstudo?
  disponibilidade      Periodo[]      @default([])
  semestre_atual       Int?
  previsao_formatura   DateTime?      @db.Date
  data_nascimento      DateTime?      @db.Date
  aplicacoes           Aplicacao[]
}

model Vaga {
  id               String           @id @default(uuid()) @db.Uuid
  codigo_vaga      String           @unique @db.VarChar(6)
  titulo           String
  descricao        String
  valor            Float
  status           StatusVaga       @default(ABERTA)
  turno            TurnoVaga?
  // Texto livre, ex.: "08h às 14h" (o turno continua separado).
  horario          String?
  cep              String?          @db.VarChar(8)
  cidade           String?
  bairro           String?
  modalidade       ModalidadeVaga?
  // Uso interno: registra o pedido da empresa; não aparece em mensagens a candidatos.
  sexo_preferencia SexoPreferencia?
  empresa_id       String           @db.Uuid
  created_at       DateTime         @default(now())
  empresa          Empresa          @relation(fields: [empresa_id], references: [id])
  aplicacoes       Aplicacao[]
}

model Aplicacao {
  id                   String             @id @default(uuid()) @db.Uuid
  vaga_id              String             @db.Uuid
  estudante_id         String             @db.Uuid
  status_kanban        StatusKanban       @default(CANDIDATO_CONTATADO)
  data_hora_entrevista DateTime?
  motivo_recusa        String?
  data_aprovacao       DateTime?
  observacao           String?            @db.Text
  entrevista_status    EntrevistaStatus?
  entrevista_formato   EntrevistaFormato?
  entrevista_local     String?
  entrevista_duracao   Int?               @default(45)
  entrevistador        String?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @default(now()) @updatedAt
  vaga                 Vaga               @relation(fields: [vaga_id], references: [id])
  estudante            Estudante          @relation(fields: [estudante_id], references: [id])
  lembretes            LembreteEmail[]

  @@unique([vaga_id, estudante_id])
}
