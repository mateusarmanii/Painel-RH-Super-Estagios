# Copie este arquivo para backend/.env e preencha com os seus dados.
# O backend/.env NÃO vai para o Git (está no .gitignore).

# Conexão com o PostgreSQL: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://postgres:troque-esta-senha@localhost:5432/superestagios?schema=public"

# Porta da API. Se mudar, ajuste também VITE_API_URL em frontend/.env.
PORT=3333

# Segredo que assina os tokens de login (JWT). Pelo menos 32 caracteres aleatórios; sem ele a API não sobe.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use um valor diferente em cada ambiente (local, produção) e nunca o coloque no Git.
JWT_SECRET=

# Endereço do frontend liberado no CORS (vários separados por vírgula). Fora de produção, localhost já é liberado.
# Em produção (Render) defina também NODE_ENV=production.
FRONTEND_URL=http://localhost:5173
